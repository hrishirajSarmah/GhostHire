# GhostHire API — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# DATABASE_URL — the SQLModel engine target.
# Local: sqlite:///./ghosthire.db
# Production (deferred to 1.1): pooled Neon URL, host contains "-pooler".
DATABASE_URL=sqlite:///./ghosthire.db

# ANTHROPIC_API_KEY — Claude API key for question generation + answer scoring.
# Get one from https://console.anthropic.com. REQUIRED — app crashes at startup if absent.
ANTHROPIC_API_KEY=

# EMBED_BACKEND — which embedding model to use for RAG.
# "local"  → BAAI/bge-small-en-v1.5 via sentence-transformers (default, no API cost)
# "openai" → text-embedding-3-small (requires OPENAI_API_KEY below)
# WARNING: DO NOT CHANGE after first ingestion — vectors from different
# models live in incompatible geometric spaces. Retrieval will silently
# degrade or fail. See CLAUDE.md §3 embedding-model-mismatch gotcha.
EMBED_BACKEND=local

# OPENAI_API_KEY — only required if EMBED_BACKEND=openai.
# Get one from https://platform.openai.com/api-keys.
# OPENAI_API_KEY=

# CHROMA_DB_PATH — optional override for the ChromaDB persistence directory.
# Default: <api/>/chroma_db (cwd-invariant, resolved via Path(__file__)).
# CHROMA_DB_PATH=